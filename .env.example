# ---- Hugging Face ----------------------------------------------------------------------
# Read access is enough for the public lang-uk Djinni datasets and every ungated model.
# A token IS required for google/gemma-4-* (accept the licence first) and for pushing
# generated datasets with scripts/push_dataset_to_hub.py.
HF_TOKEN=hf_your_token_here
HF_TARGET_ORG=Stereotypes-in-LLMs

# ---- Weights & Biases ------------------------------------------------------------------
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=hiring-bias-mitigation
WANDB_ENTITY=your_wandb_entity

# ---- Local storage ---------------------------------------------------------------------
# Everything heavy (base-model downloads, generated datasets, trained adapters, raw
# generation dumps) lives off the system disk. Configs keep short relative paths like
# "outputs/sft/x"; HBM_OUTPUT_ROOT relocates the whole tree, so no config file carries a
# machine-specific absolute path.
#
# Point these at a STABLE mount point (pinned by UUID in /etc/fstab), NOT at a udisks2
# auto-mount path under /media/<user>/ -- udisks renames its mount point whenever a
# directory of that name is already there, and Docker creates exactly such a directory on
# the system disk when it bind-mounts a missing source path.
#
# As a backstop, training and generation refuse to start unless
# $HBM_OUTPUT_ROOT/.hbm-models-root exists. Create that marker once, on the drive, after
# mounting it. Set HBM_ALLOW_LOCAL_OUTPUT=1 to bypass on a machine with no model drive.
HBM_MODELS_ROOT=/media/naz2001r/Transcend/hiring-bias-models
HBM_OUTPUT_ROOT=/media/naz2001r/Transcend/hiring-bias-models
HF_HOME=/media/naz2001r/Transcend/hiring-bias-models/hf-cache
WANDB_DIR=/media/naz2001r/Transcend/hiring-bias-models/wandb

# Off by default -- nothing is ever published automatically.
PUSH_TO_HUB=false
